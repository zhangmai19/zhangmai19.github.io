---
layout: default
---
<div class="post home-page">
  <article>
    <section class="home-intro" aria-labelledby="home-title">
      <div class="home-intro-copy">
        <p class="eyebrow">{{ page.eyebrow }}</p>
        <h1 id="home-title">
          {{ site.first_name }}
          {{ site.last_name -}}
          <span class="name-period">.</span>
        </h1>
        <p class="home-headline">{{ page.headline }}</p>
        <div class="home-bio">{{ content }}</div>
        <div class="home-links">
          <a class="contact-link" href="mailto:{{ site.data.socials.email | encode_email }}">Get in touch <span aria-hidden="true">↗</span></a>
          <a href="{{ '/cv/' | relative_url }}">Curriculum vitae <span aria-hidden="true">↗</span></a>
          {% if site.data.socials.github_username %}
            <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub <span aria-hidden="true">↗</span></a>
          {% endif %}
        </div>
      </div>
      {% if page.profile.image %}
        <aside class="home-portrait" aria-label="Portrait and office">
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% include figure.liquid loading='eager' path=profile_image_path class='portrait-image' sizes='(min-width: 768px) 280px, 70vw' alt='Mai Zhang' cache_bust=true %}
          <div class="portrait-caption">
            <span class="eyebrow">Based in Hong Kong</span>
            {% if page.profile.more_info %}
              <div class="office-address">{{ page.profile.more_info }}</div>
            {% endif %}
          </div>
        </aside>
      {% endif %}
    </section>

    <div class="home-interests" aria-label="Academic interests">
      <span class="eyebrow">Areas of interest</span>
      <ul>
        {% for interest in page.interests %}
          <li>{{ interest }}</li>
        {% endfor %}
      </ul>
      <a href="{{ '/publications/' | relative_url }}">Explore research <span aria-hidden="true">↗</span></a>
    </div>

    <div class="home-secondary">
      <section class="home-background" aria-labelledby="background-title">
        <p class="eyebrow">01 / Background</p>
        <h2 id="background-title">
          Across economics<br>
          &amp; statistics.
        </h2>
        <div class="education-list">
          {% for entry in site.data.cv.cv.sections.Education %}
            <div class="education-entry">
              <h3>{{ entry.institution }}</h3>
              <p>{{ entry.studyType }} in {{ entry.area }}</p>
              {% for highlight in entry.highlights %}
                <p class="education-detail">{{ highlight }}</p>
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      </section>
      {% if page.daily_book.enabled and site.data.books.size > 0 %}
        <section class="home-reading" aria-labelledby="reading-title">
          <p class="eyebrow">02 / Off the page</p>
          <h2 id="reading-title">A life between books.</h2>
          <p class="reading-description">From mathematics to fiction, a record of what I read and what I want to read next.</p>
          {% include daily_book.liquid %}
          <a class="text-link" href="{{ '/books/' | relative_url }}">Browse the bookshelf <span aria-hidden="true">↗</span></a>
        </section>
      {% endif %}
    </div>

    {% if page.selected_papers %}
      {% capture selected_papers %}{% include selected_papers.liquid %}{% endcapture %}
      {% if selected_papers contains '<li' %}
        <section class="home-section" aria-labelledby="selected-title">
          <h2 id="selected-title"><a href="{{ '/publications/' | relative_url }}">Selected publications</a></h2>
          {{ selected_papers }}
        </section>
      {% endif %}
    {% endif %}
    {% if page.announcements.enabled and site.news.size > 0 %}
      <section class="home-section" aria-labelledby="news-title">
        <h2 id="news-title"><a href="{{ '/news/' | relative_url }}">News</a></h2>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}
    {% if page.latest_posts.enabled and site.posts.size > 0 %}
      <section class="home-section" aria-labelledby="posts-title">
        <h2 id="posts-title"><a href="{{ '/blog/' | relative_url }}">Recent writing</a></h2>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}
    <p class="home-motto">Chance favors only the prepared mind.</p>
  </article>
</div>
