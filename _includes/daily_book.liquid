{% assign reading_books = site.data.books | where: 'status', 'Read' %}
{% assign first_book = reading_books.first | default: site.data.books.first %}
<div id="daily-book" class="daily-book-card">
  <p class="eyebrow">From my bookshelf <span aria-hidden="true">/</span> Today's pick</p>
  <div id="daily-book-content">
    <a class="daily-book-title" href="https://www.google.com/search?q={{ first_book.name | append: ' ' | append: first_book.author | url_encode }}">
      {{- first_book.name | escape -}}
    </a>
    <p class="daily-book-author">{{ first_book.author | escape }}</p>
    <p class="daily-book-type">{{ first_book.type | escape }}</p>
  </div>
</div>
<script type="application/json" id="daily-book-data">
  {{ reading_books | jsonify | replace: '</', '<\/' }}
</script>
<script>
  (() => {
    const books = JSON.parse(document.getElementById('daily-book-data').textContent);
    if (!books.length) return;
    const today = new Date();
    const seed = today.getFullYear() + '-' + (today.getMonth() + 1) + '-' + today.getDate();
    let hash = 0;
    for (const character of seed) hash = ((hash << 5) - hash + character.charCodeAt(0)) | 0;
    const book = books[Math.abs(hash) % books.length];
    const title = document.querySelector('#daily-book .daily-book-title');
    title.textContent = book.name;
    title.href = 'https://www.google.com/search?q=' + encodeURIComponent(book.name + ' ' + book.author);
    document.querySelector('#daily-book .daily-book-author').textContent = book.author;
    document.querySelector('#daily-book .daily-book-type').textContent = book.type;
  })();
</script>
